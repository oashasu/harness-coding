{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HarnessReviewResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "task_id",
    "task_scope",
    "phase",
    "execution_unit",
    "review_status",
    "summary",
    "report_path"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "const": "v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier of the task being reviewed",
      "pattern": "^(stage|gen_node):[a-z]+:[A-Za-z0-9_]+:[a-z0-9_-]+$"
    },
    "task_scope": {
      "type": "string",
      "enum": [
        "stage",
        "gen_node"
      ],
      "description": "Scope of the task: stage-level or gen_node-level"
    },
    "phase": {
      "type": "string",
      "enum": [
        "req_draft",
        "req_review",
        "spec_draft",
        "spec_review",
        "code_impl",
        "machine_check",
        "dual_review",
        "final_accept",
        "knowledge_archive",
        "DONE",
        "TERMINATED"
      ],
      "description": "Phase this review belongs to"
    },
    "execution_unit": {
      "type": "string",
      "minLength": 1,
      "description": "Execution unit identifier (stage name or Gxx node)"
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "description": "Required when task_scope is gen_node. Format: G01-G09",
      "pattern": "^G0[1-9]$"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rework_required",
        "rejected"
      ],
      "description": "Final review decision"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Brief summary of review findings"
    },
    "report_path": {
      "type": "string",
      "minLength": 1,
      "description": "Path to detailed review report"
    },
    "rework_items": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "description",
          "severity"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          },
          "file_path": {
            "type": "string"
          },
          "line_range": {
            "type": "string"
          }
        }
      },
      "description": "List of items requiring rework when status is rework_required"
    },
    "patch_allowed": {
      "type": "boolean",
      "description": "Whether patch-based fixes are allowed for this review"
    },
    "reviewer": {
      "type": "string",
      "description": "Reviewer agent or role identifier"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of review completion"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task_scope": {
            "const": "gen_node"
          }
        }
      },
      "then": {
        "required": [
          "node_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "rework_required"
          }
        }
      },
      "then": {
        "required": [
          "rework_items"
        ],
        "properties": {
          "rework_items": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$id": "harness-review-result.v1.schema.json"
}