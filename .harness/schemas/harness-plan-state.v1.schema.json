{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "harness-plan-state.v1.schema.json",
  "title": "HarnessPlanStateV1",
  "description": "DAG execution blueprint for multi-agent parallel control. Generalized from state-contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch_id",
    "steps"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "description": "Batch identifier, e.g. 'BATCH-20260607-001'"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "DAG execution steps",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "owner",
          "depends_on",
          "reads",
          "writes",
          "checks"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "enum": [
              "requirement-engineer",
              "spec-architect",
              "coding-worker",
              "test-evaluator",
              "arch-evaluator",
              "knowledge-curator",
              "harness-governor",
              "Human"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reads": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/|~/|[a-zA-Z]:\\\\|\\.\\.([\\\\/]|$)|(.*[\\\\/]\\.\\.([\\\\/]|$))).*$"
            }
          },
          "writes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/|~/|[a-zA-Z]:\\\\|\\.\\.([\\\\/]|$)|(.*[\\\\/]\\.\\.([\\\\/]|$))).*$"
            }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}