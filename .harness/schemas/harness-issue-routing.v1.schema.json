{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "harness-issue-routing.v1.schema.json",
  "title": "HarnessIssueRoutingV1",
  "description": "Issue routing and validation result. Generalized from prove-issue-routing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_validation",
    "issue_normalization",
    "solution_collapse",
    "routing",
    "allow_proceed",
    "gate_context_update"
  ],
  "properties": {
    "domain_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "blocked_items",
        "check_timestamp"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "blocked_items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "check_timestamp": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "issue_normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_questions"
      ],
      "properties": {
        "normalized_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seq",
              "question_normalized",
              "severity"
            ],
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1
              },
              "question_normalized": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": [
                  "CRITICAL",
                  "HIGH",
                  "MEDIUM",
                  "LOW"
                ]
              }
            }
          }
        }
      }
    },
    "solution_collapse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collapsed_solutions"
      ],
      "properties": {
        "collapsed_solutions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "solution_id",
              "description"
            ],
            "properties": {
              "solution_id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auto_resolvable",
        "proceed_with_risk",
        "human_required"
      ],
      "properties": {
        "auto_resolvable": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seq",
              "status",
              "resolution_plan"
            ],
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "pending_evidence",
                  "resolved"
                ]
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "resolution_plan": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "method"
                ],
                "properties": {
                  "method": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "proceed_with_risk": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seq",
              "status",
              "risk",
              "mitigation_plan"
            ],
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending_evidence_with_risk",
                  "risk_logged",
                  "accepted_with_warning"
                ]
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "risk": {
                "type": "string",
                "minLength": 1
              },
              "mitigation_plan": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "human_required": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seq",
              "question",
              "severity",
              "status",
              "block_condition"
            ],
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": [
                  "CRITICAL",
                  "HIGH",
                  "MEDIUM",
                  "LOW"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "awaiting_human",
                  "confirmed"
                ]
              },
              "block_condition": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "allow_proceed": {
      "type": "string",
      "enum": [
        "UNSET",
        "YES",
        "NO",
        "YES_WITH_WARNING"
      ]
    },
    "gate_context_update": {
      "type": "object",
      "additionalProperties": true,
      "description": "Gate conditions to update. Keys are configurable per project."
    }
  }
}